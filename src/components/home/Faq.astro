---
/**
 * "Preguntas Frecuentes" (225:729 desktop / 256:273 móvil). Acordeón con <details>,
 * sin JavaScript: la altura se anima con CSS donde el navegador lo soporta.
 */
import { ChevronRight } from "../ui/icons";
import { SITE } from "../../config/site";

const preguntas = [
  {
    q: "¿Cómo puedo ver los perfiles disponibles?",
    a: "En la sección «Modelos Disponibles» están todas nuestras modelos. Toca «Ver perfil» para conocer sus datos, tarifa y cobertura.",
  },
  {
    q: "¿Cómo consulto la disponibilidad de una modelo?",
    a: "Entra a su perfil y toca «Consultar disponibilidad». Eliges duración, modalidad, fecha y horario, y confirmas tu reserva por WhatsApp.",
  },
  {
    q: `¿La atención es solo en ${SITE.ciudad}?`,
    a: `Por ahora atendemos en ${SITE.ciudad}. Muy pronto vamos a ampliar la cobertura a más departamentos de El Salvador.`,
  },
];
---

<section class="container-lr py-16 md:py-[clamp(64px,5.6vw,108px)]">
  <div class="flex items-center gap-[2.7vw]">
    <h2 class="t-section reveal shrink-0">Preguntas Frecuentes</h2>
    <span class="bg-cta shadow-glass-thin hidden h-[clamp(4px,0.38vw,7.4px)] flex-1 rounded-full md:block"></span>
  </div>
  <div class="mt-8 flex flex-col gap-4 md:mt-[2.8vw] md:gap-[2.8vw]">
    {
      preguntas.map(({ q, a }) => (
        <details class="faq reveal group rounded-[28px] bg-black/20 shadow-glass-thin transition-colors open:bg-white/[0.06] md:rounded-[clamp(28px,3vw,50px)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[16px] font-light md:px-[2.1vw] md:py-[0.52vw] md:text-[clamp(16px,1.65vw,31.8px)] [&::-webkit-details-marker]:hidden">
            <span>{q}</span>
            <ChevronRight className="h-[0.55em] w-auto shrink-0 rotate-90 transition-transform duration-300 group-open:-rotate-90" />
          </summary>
          <div class="faq-body">
            <p class="px-5 pb-5 text-[15px] font-light leading-relaxed text-ink/80 md:px-[2.1vw] md:pb-[1.2vw] md:text-[clamp(15px,1.2vw,24px)]">{a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Altura animada al abrir/cerrar (Chrome 131+ / Safari 18.4+). En el resto, abre sin animación. */
  .faq {
    interpolate-size: allow-keywords;
  }
  .faq::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.35s var(--ease-out-soft),
      content-visibility 0.35s allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
  }
</style>
