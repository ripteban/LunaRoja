---
/**
 * Hero de la home (67:152 desktop / 151:329 móvil): fondo cósmico, silueta, título "Luna Roja",
 * subtítulo y CTA a la grilla de modelos.
 */
import { Image } from "astro:assets";
import CosmicBackground from "../layout/CosmicBackground.astro";
import CtaLink from "../ui/CtaLink.astro";
import { Silhouette } from "../ui/icons";
import titulo from "../../assets/brand/luna-roja-titulo.png";
import { SITE } from "../../config/site";
---

<section class="relative isolate h-[835px] max-h-[110svh] overflow-hidden md:h-[min(56.25vw,1080px)] md:min-h-[640px]">
  <CosmicBackground />

  <!-- Silueta: en desktop ocupa 34.8 % del ancho desde 13.9 % de alto (Figma). -->
  <div
    class="absolute bottom-[73px] left-1/2 w-[471px] -translate-x-1/2 md:bottom-0 md:w-[34.8%] md:max-w-none"
  >
    <div class="animate-rise" style="animation-delay:120ms">
      <Silhouette className="block h-auto w-full" />
    </div>
  </div>

  <!-- Sombra bajo el título para que se lea sobre las nubes -->
  <div class="absolute inset-x-[-10%] bottom-[8%] h-[37%] rounded-[50%] bg-bg/70 blur-[60px] md:bottom-[10%]"></div>

  <div class="absolute inset-x-0 bottom-[38px] flex flex-col items-center px-4 md:bottom-auto md:top-[46%] md:items-stretch md:px-[11vw]">
    <h1 class="animate-rise" style="animation-delay:260ms">
      <Image
        src={titulo}
        alt="Luna Roja"
        widths={[360, 720, 1100, 1568]}
        sizes="(min-width: 768px) 82vw, 82vw"
        loading="eager"
        class="mx-auto w-[82vw] max-w-[338px] md:max-w-none"
      />
    </h1>
    <p
      class="mt-3 max-w-[379px] animate-rise text-center font-display text-[24.6px] leading-snug text-white md:mt-[1.2vw] md:max-w-none md:pl-[0.4vw] md:text-left md:text-[clamp(18px,1.82vw,35px)]"
      style="animation-delay:380ms"
    >
      {SITE.descripcion}
    </p>
    <CtaLink
      href="#modelos"
      class="mt-6 h-[54px] w-full max-w-[364px] animate-rise text-[19px] md:mt-[2.2vw] md:h-[clamp(44px,3.08vw,59px)] md:w-[clamp(240px,20.85vw,400px)] md:text-[clamp(15px,1.12vw,21.5px)]"
      style="animation-delay:480ms"
    >
      Modelos Disponibles
    </CtaLink>
  </div>
</section>
