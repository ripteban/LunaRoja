---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PasoReserva from "../../../components/booking/PasoReserva.astro";
import BookingModelCard from "../../../components/booking/BookingModelCard.astro";
import BookingFlow from "../../../components/booking/BookingFlow";
import { agendaDe, modelosActivas, zonaDe, type Modelo } from "../../../lib/modelos";

export async function getStaticPaths() {
  const modelos = await modelosActivas();
  return modelos.map((modelo) => ({ params: { slug: modelo.id }, props: { modelo } }));
}

interface Props {
  modelo: Modelo;
}
const { modelo } = Astro.props;
const d = modelo.data;
---

<BaseLayout title={`Disponibilidad de ${d.nombre}`}>
  <PasoReserva titulo="Disponibilidad, Servicio y Duración.">
    <div class="grid items-start gap-6 xl:grid-cols-[388fr_1254fr] xl:gap-[1.44vw]">
      <BookingModelCard modelo={modelo} />
      <BookingFlow
        client:load
        slug={modelo.id}
        nombre={d.nombre}
        zona={zonaDe(modelo)}
        tarifaHora={d.tarifaHora}
        modalidades={d.modalidades}
        agenda={agendaDe(modelo)}
      />
    </div>
  </PasoReserva>
</BaseLayout>
